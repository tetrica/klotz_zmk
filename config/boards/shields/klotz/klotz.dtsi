#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	chosen {
		/* Composite = the key matrix + the encoder push-buttons (direct GPIO). */
		zmk,kscan = &kscan_composite;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows = <5>;
		/* Row 4 holds the encoder push-buttons: RC(4,0) = LEFT encoder (this
		 * half has no col-offset), RC(4,5) = RIGHT encoder (klotz_right.overlay
		 * sets col-offset = 5, so its composite (4,0) maps to (4,5) here).
		 * These are the last two key positions (34 = left, 35 = right). */
		map = <
		RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
		RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
		RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
		                        RC(3,3) RC(3,4)    RC(3,5) RC(3,6)
		RC(4,0)                                                       RC(4,5)
		>;
	};


	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		label = "KSCAN";

		diode-direction = "col2row";
		row-gpios
			= <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
	};

	/* Encoder push-button as a direct GPIO key on D4 (free on both halves;
	 * matrix uses D6-D10/D14-D16/D18, encoder rotation D19/D20, trackpad
	 * D0-D3). Wire the encoder's switch pin to D4 and its other leg to GND. */
	encoder_btn: kscan_encoder_btn {
		compatible = "zmk,kscan-gpio-direct";
		input-gpios = <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	/* Merge the key matrix (rows 0-3) with the encoder button (row 4). */
	kscan_composite: kscan_composite {
		compatible = "zmk,kscan-composite";
		rows = <5>;
		columns = <5>;

		matrix {
			kscan = <&kscan0>;
		};

		encoder {
			kscan = <&encoder_btn>;
			row-offset = <4>;
			column-offset = <0>;
		};
	};

	left_encoder: encoder_left {
		compatible = "alps,ec11";
		a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <24>;
		status = "disabled";
	};

	right_encoder: encoder_right {
		compatible = "alps,ec11";
		a-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <24>;
		status = "disabled";
	};

	sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder &right_encoder>;
		triggers-per-rotation = <6>;
	};
};
